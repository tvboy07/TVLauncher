<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TVLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="TVLauncher.Views.ModrinthBrowserWindow"
        x:DataType="vm:ModrinthBrowserViewModel"
        Title="TVLauncher - Tienda de Mods (Modrinth)"
        Width="900" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="TIENDA DE MODS - MODRINTH" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"/>
            <TextBlock Text="Busca y descarga mods directamente a tu instancia" 
                       Foreground="#AAAAAA"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Search & Filters -->
        <Border Grid.Row="1" 
                Background="#1E1E1E" 
                BorderBrush="#3F3F3F" 
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" 
                         Text="{Binding SearchQuery}" 
                         Watermark="Buscar mods..."
                         Background="#2D2D2D"
                         Foreground="White"
                         Margin="0,0,10,0"/>
                
                <ComboBox Grid.Column="1" 
                          SelectedItem="{Binding SelectedGameVersion}"
                          ItemsSource="{Binding GameVersions}"
                          Background="#2D2D2D"
                          Foreground="White"
                          Margin="0,0,10,0"/>
                
                <ComboBox Grid.Column="2" 
                          SelectedItem="{Binding SelectedModLoader}"
                          ItemsSource="{Binding ModLoaders}"
                          Background="#2D2D2D"
                          Foreground="White"
                          Margin="0,0,10,0"/>
                
                <Button Grid.Column="3" 
                        Content="BUSCAR" 
                        Command="{Binding SearchCommand}"
                        Background="#0078D4"
                        Foreground="White"
                        Padding="20,8"/>
            </Grid>
        </Border>

        <!-- Results -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Mods List -->
            <Border Grid.Column="0" 
                    Background="#1E1E1E" 
                    BorderBrush="#3F3F3F" 
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding SearchResults}"
                         SelectedItem="{Binding SelectedProject}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10" ColumnDefinitions="50,*">
                                <Border Grid.Column="0" 
                                        Width="48" Height="48" 
                                        Background="#2D2D2D" 
                                        CornerRadius="4">
                                    <TextBlock Text="📦" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"
                                               FontSize="24"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" 
                                               Foreground="White"
                                               FontWeight="SemiBold"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Author}" 
                                               Foreground="#AAAAAA"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding Description}" 
                                               Foreground="#CCCCCC"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxLines="2"/>
                                    <TextBlock Text="{Binding Downloads, StringFormat='⬇ {0:N0} descargas'}" 
                                               Foreground="#888888"
                                               FontSize="10"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Project Details -->
            <Border Grid.Column="1" 
                    Background="#1E1E1E" 
                    BorderBrush="#3F3F3F" 
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252525" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1" Padding="15,10">
                        <TextBlock Text="VERSIONES COMPATIBLES" 
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding ProjectVersions}"
                             SelectedItem="{Binding SelectedVersion}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <TextBlock Text="{Binding Name}" 
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding VersionNumber}" 
                                               Foreground="#AAAAAA"
                                               FontSize="11"/>
                                    <TextBlock Text="{Binding GameVersions[0]}" 
                                               Foreground="#888888"
                                               FontSize="10"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button Grid.Row="2" 
                            Content="DESCARGAR A INSTANCIA" 
                            Command="{Binding DownloadModCommand}"
                            Background="#107C10"
                            Foreground="White"
                            Margin="10"
                            Padding="10,8"
                            HorizontalAlignment="Stretch"
                            IsEnabled="{Binding SelectedVersion, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status + progreso de descarga -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0" Spacing="6">
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding DownloadProgress}"
                         IsVisible="{Binding IsDownloading}"
                         Height="6"/>
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="#AAAAAA"/>
        </StackPanel>
    </Grid>
</Window>

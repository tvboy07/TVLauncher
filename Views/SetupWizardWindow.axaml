<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TVLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
        x:Class="TVLauncher.Views.SetupWizardWindow"
        x:DataType="vm:SetupWizardViewModel"
        Title="TVLauncher - Configuración Inicial"
        Width="600" Height="400"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#121212">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Bienvenido a TVLauncher" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Configuración inicial" 
                       FontSize="14" 
                       Foreground="#AAAAAA"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Content -->
        <Carousel Grid.Row="1" SelectedIndex="{Binding CurrentStep}">
            <!-- Step 0: Bienvenida -->
            <StackPanel Spacing="15" VerticalAlignment="Center">
                <TextBlock Text="¡Gracias por usar TVLauncher!" 
                           FontSize="20" 
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Un launcher de Minecraft ultraligero, de alto rendimiento y código abierto." 
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"/>
                <TextBlock Text="Vamos a configurar algunos ajustes opcionales para optimizar tu experiencia." 
                           Foreground="#AAAAAA"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Step 1: Módulos Opcionales -->
            <StackPanel Spacing="15" VerticalAlignment="Center">
                <TextBlock Text="Módulos Opcionales" 
                           FontSize="20" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <Border Background="#1E1E1E" 
                        BorderBrush="#3F3F3F" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel Spacing="15">
                        <CheckBox IsChecked="{Binding EnableModrinthStore}" 
                                  Content="Tienda de Mods de Modrinth"
                                  Foreground="White"/>
                        <TextBlock Text="Permite buscar y descargar mods desde Modrinth directamente desde el launcher." 
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   Margin="25,-10,0,0"
                                   TextWrapping="Wrap"/>
                        
                        <CheckBox IsChecked="{Binding EnableCosmetics}" 
                                  Content="Sistema de Cosméticos TVLauncher"
                                  Foreground="White"/>
                        <TextBlock Text="Habilita el armario de cosméticos y la inyección del mod tvl-cosmetics.jar." 
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   Margin="25,-10,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 2: Rendimiento -->
            <StackPanel Spacing="15" VerticalAlignment="Center">
                <TextBlock Text="Optimización de Rendimiento" 
                           FontSize="20" 
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"/>
                
                <Border Background="#1E1E1E" 
                        BorderBrush="#3F3F3F" 
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="20">
                    <StackPanel Spacing="15">
                        <CheckBox IsChecked="{Binding AutoOptimizeMemory}" 
                                  Content="Optimización automática de memoria al jugar"
                                  Foreground="White"/>
                        <TextBlock Text="Libera memoria caché al pulsar 'Jugar' para destinar más RAM a Minecraft." 
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   Margin="25,-10,0,0"
                                   TextWrapping="Wrap"/>
                        
                        <TextBlock Text="TVLauncher está diseñado para usar menos de 50MB de RAM en segundo plano." 
                                   Foreground="#107C10"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Carousel>

        <!-- Navigation -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,30,0,0">
            <Button Content="ATRÁS" 
                    Command="{Binding PreviousStepCommand}"
                    IsVisible="{Binding CurrentStep}"
                    Background="#2D2D2D"
                    Foreground="White"
                    Padding="30,10"/>
            <Button Content="SIGUIENTE" 
                    Command="{Binding NextStepCommand}"
                    Background="#0078D4"
                    Foreground="White"
                    Padding="30,10"/>
        </StackPanel>
    </Grid>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TVLauncher.ViewModels"
        xmlns:models="using:TVLauncher.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="520"
        x:Class="TVLauncher.Views.AccountManagerWindow"
        x:DataType="vm:AccountManagerViewModel"
        Title="TVLauncher — Cuentas"
        Width="520" Height="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <StackPanel Grid.Row="0" Spacing="3" Margin="0,0,0,16">
            <TextBlock Text="Cuentas" Classes="h1" FontSize="22"/>
            <TextBlock Text="Gestiona tus cuentas de Microsoft y offline" Classes="caption"/>
        </StackPanel>

        <!-- Añadir cuenta offline -->
        <Border Grid.Row="1" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <TextBlock Text="CUENTA OFFLINE" Classes="label"/>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding OfflineUsername}"
                             Watermark="Nombre de usuario (máx. 16 caracteres)"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1"
                            Content="Añadir"
                            Classes="primary"
                            Command="{Binding AddOfflineAccountCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Añadir cuenta Microsoft -->
        <Border Grid.Row="2" Classes="card" Padding="16" Margin="0,0,0,12">
            <StackPanel Spacing="10">
                <TextBlock Text="CUENTA MICROSOFT" Classes="label"/>
                <Button Content="Iniciar sesión con Microsoft"
                        Classes="primary"
                        Command="{Binding AddMicrosoftAccountCommand}"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding !IsMicrosoftAuthenticating}"/>

                <StackPanel Spacing="8" IsVisible="{Binding IsMicrosoftAuthenticating}">
                    <TextBlock Text="Código de dispositivo:" Classes="caption"/>
                    <TextBlock Text="{Binding DeviceCode}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentHoverBrush}"
                               IsVisible="{Binding ShowDeviceCode}"/>
                    <Button Content="Abrir página de autenticación"
                            Classes="ghost"
                            Command="{Binding OpenVerificationUrlCommand}"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding ShowDeviceCode}"/>
                    <Button Content="Cancelar"
                            Classes="ghost"
                            Command="{Binding CancelMicrosoftAuthCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lista de cuentas -->
        <Border Grid.Row="3" Classes="card" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <TextBlock Text="CUENTAS GUARDADAS" Classes="label"/>
                </Border>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Accounts}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:MinecraftAccount">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                                    <TextBlock Classes="caption" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} | {1}">
                                                <Binding Path="Type"/>
                                                <Binding Path="Uuid" StringFormat="{}{0:..8}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Content="Activar"
                                        Classes="ghost"
                                        Command="{Binding $parent[Window].((vm:AccountManagerViewModel)DataContext).SetActiveCommand}"
                                        CommandParameter="{Binding}"
                                        Margin="5,0"
                                        IsVisible="{Binding !IsActive}"/>

                                <Button Grid.Column="2"
                                        Content="Eliminar"
                                        Classes="ghost"
                                        Command="{Binding $parent[Window].((vm:AccountManagerViewModel)DataContext).RemoveAccountCommand}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Estado -->
        <TextBlock Grid.Row="4"
                   Text="{Binding StatusMessage}"
                   Classes="caption"
                   Margin="0,12,0,12"
                   TextWrapping="Wrap"/>

        <!-- Botón cerrar -->
        <Button Grid.Row="5"
                Content="Cerrar"
                Classes="ghost"
                Command="{Binding CloseCommand}"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>

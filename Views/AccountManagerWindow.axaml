<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TVLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="450"
        x:Class="TVLauncher.Views.AccountManagerWindow"
        x:DataType="vm:AccountManagerViewModel"
        Title="TVLauncher - Gestión de Cuentas"
        Width="500" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="CUENTAS" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="White"
                   Margin="0,0,0,15"/>

        <!-- Añadir cuenta offline -->
        <Border Grid.Row="1" 
                Background="#1E1E1E" 
                BorderBrush="#3F3F3F" 
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <TextBlock Text="Cuenta Offline" 
                           Foreground="White" 
                           FontWeight="SemiBold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding OfflineUsername}"
                             Watermark="Nombre de usuario (máx. 16 caracteres)"
                             Background="#2D2D2D"
                             Foreground="White"
                             BorderBrush="#3F3F3F"
                             Margin="0,0,10,0"/>
                    <Button Grid.Column="1" 
                            Content="Añadir" 
                            Command="{Binding AddOfflineAccountCommand}"
                            Background="#0078D4"
                            Foreground="White"
                            Padding="20,8"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Añadir cuenta Microsoft -->
        <Border Grid.Row="2" 
                Background="#1E1E1E" 
                BorderBrush="#3F3F3F" 
                BorderThickness="1"
                CornerRadius="4"
                Padding="15"
                Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <TextBlock Text="Cuenta Microsoft" 
                           Foreground="White" 
                           FontWeight="SemiBold"/>
                <Button Content="Iniciar sesión con Microsoft" 
                        Command="{Binding AddMicrosoftAccountCommand}"
                        Background="#00A4EF"
                        Foreground="White"
                        Padding="15,8"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding !IsMicrosoftAuthenticating}"/>
                
                <StackPanel Spacing="8" IsVisible="{Binding IsMicrosoftAuthenticating}">
                    <TextBlock Text="Código de dispositivo:" 
                               Foreground="#AAAAAA"/>
                    <TextBlock Text="{Binding DeviceCode}" 
                               Foreground="White" 
                               FontSize="24" 
                               FontWeight="Bold"
                               IsVisible="{Binding ShowDeviceCode}"/>
                    <Button Content="Abrir página de autenticación" 
                            Command="{Binding OpenVerificationUrlCommand}"
                            Background="#2D2D2D"
                            Foreground="White"
                            Padding="15,8"
                            HorizontalAlignment="Left"
                            IsVisible="{Binding ShowDeviceCode}"/>
                    <Button Content="Cancelar" 
                            Command="{Binding CancelMicrosoftAuthCommand}"
                            Background="#D13438"
                            Foreground="White"
                            Padding="15,8"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Lista de cuentas -->
        <Border Grid.Row="3" 
                Background="#1E1E1E" 
                BorderBrush="#3F3F3F" 
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Border Grid.Row="0" Background="#252525" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                    <TextBlock Text="CUENTAS GUARDADAS" 
                               Foreground="#FFFFFF"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="15,0"/>
                </Border>
                
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding Accounts}"
                         Background="Transparent"
                         BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Username}" 
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#AAAAAA" FontSize="11">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} | {1}">
                                                <Binding Path="Type"/>
                                                <Binding Path="Uuid" StringFormat="{}{0:..8}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                                
                                <Button Grid.Column="1" 
                                        Content="Activar" 
                                        Command="{Binding $parent[Window].((vm:AccountManagerViewModel)DataContext).SetActiveCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#107C10"
                                        Foreground="White"
                                        Padding="15,5"
                                        Margin="5,0"
                                        IsVisible="{Binding !IsActive}"/>
                                
                                <Button Grid.Column="2" 
                                        Content="Eliminar" 
                                        Command="{Binding $parent[Window].((vm:AccountManagerViewModel)DataContext).RemoveAccountCommand}"
                                        CommandParameter="{Binding}"
                                        Background="#D13438"
                                        Foreground="White"
                                        Padding="15,5"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Estado -->
        <TextBlock Grid.Row="4" 
                   Text="{Binding StatusMessage}" 
                   Foreground="#AAAAAA"
                   Margin="0,10,0,10"
                   TextWrapping="Wrap"/>

        <!-- Botón cerrar -->
        <Button Grid.Row="5" 
                Content="Cerrar" 
                Command="{Binding CloseCommand}"
                Background="#2D2D2D"
                Foreground="White"
                Padding="30,8"
                HorizontalAlignment="Right"/>
    </Grid>
</Window>

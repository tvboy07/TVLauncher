<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TVLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="470" d:DesignHeight="500"
        x:Class="TVLauncher.Views.InstanceEditWindow"
        x:DataType="vm:InstanceEditViewModel"
        Title="TVLauncher — Editar instancia"
        Width="470" Height="560"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource AppBackgroundBrush}">

    <!-- El formulario supera la altura de la ventana en pantallas ajustadas o con
         escalado alto: se desplaza dentro del ScrollViewer y los botones quedan
         anclados abajo, siempre visibles. -->
    <Grid Margin="24" RowDefinitions="*,Auto">

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,10,0" Spacing="14">

                <StackPanel Spacing="3" Margin="0,0,0,4">
                    <TextBlock Text="Editar instancia" Classes="h1" FontSize="22"/>
                    <TextBlock Text="Ajusta la versión, el cargador y la memoria asignada"
                               Classes="caption"/>
                </StackPanel>

                <!-- Nombre -->
                <StackPanel Spacing="6">
                    <TextBlock Text="NOMBRE DE LA INSTANCIA" Classes="label"/>
                    <TextBox Text="{Binding InstanceName}"/>
                </StackPanel>

                <!-- Versión -->
                <StackPanel Spacing="6">
                    <TextBlock Text="VERSIÓN DE MINECRAFT" Classes="label"/>
                    <ComboBox ItemsSource="{Binding Versions}"
                              SelectedItem="{Binding SelectedVersion}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- ModLoader -->
                <StackPanel Spacing="6">
                    <TextBlock Text="CARGADOR DE MODS" Classes="label"/>
                    <ComboBox ItemsSource="{Binding ModLoaders}"
                              SelectedItem="{Binding SelectedModLoader}"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Versión del ModLoader -->
                <StackPanel Spacing="6">
                    <TextBlock Text="VERSIÓN DEL CARGADOR (FABRIC/FORGE/NEOFORGE)" Classes="label"/>
                    <ComboBox ItemsSource="{Binding ModLoaderVersions}"
                              SelectedItem="{Binding SelectedModLoaderVersion}"
                              PlaceholderText="Última versión disponible"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- RAM -->
                <Border Classes="card" Padding="16" Margin="0,2,0,0">
                    <StackPanel Spacing="10">
                        <TextBlock Text="MEMORIA RAM" Classes="label"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Mínima" Classes="caption"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MinRamGB, StringFormat='{}{0} GB'}"
                                       Classes="caption"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="16" Value="{Binding MinRamGB}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Máxima" Classes="caption"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MaxRamGB, StringFormat='{}{0} GB'}"
                                       Classes="caption"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Grid>
                        <Slider Minimum="1" Maximum="16" Value="{Binding MaxRamGB}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </StackPanel>
                </Border>

                <!-- Estado -->
                <TextBlock Text="{Binding StatusMessage}"
                           Classes="caption"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Botones (anclados, fuera del área desplazable) -->
        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnDefinitions="*,Auto,Auto">
            <Button Grid.Column="1" Content="Cancelar" Classes="ghost"
                    Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
            <Button Grid.Column="2" Content="Guardar" Classes="primary"
                    Command="{Binding SaveCommand}"/>
        </Grid>
    </Grid>
</Window>

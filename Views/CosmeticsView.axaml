<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TVLauncher.ViewModels"
             xmlns:services="using:TVLauncher.Services"
             xmlns:controls="using:TVLauncher.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="460"
             x:Class="TVLauncher.Views.CosmeticsView"
             x:DataType="vm:SkinsPreviewViewModel">

    <UserControl.Resources>
        <!-- Plantilla compartida por las pestañas Capas / Sombreros / Alas -->
        <DataTemplate x:Key="CosmeticTemplate" x:DataType="services:CosmeticItem">
            <Border Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10"
                    Margin="0,0,0,8">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Type}" Classes="caption" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="PREMIUM" Foreground="{StaticResource WarningBrush}" FontSize="10" FontWeight="Bold"
                                   VerticalAlignment="Center" IsVisible="{Binding !IsOwned}"/>
                        <Button Content="Equipar"
                                Classes="primary"
                                Command="{Binding $parent[UserControl].((vm:SkinsPreviewViewModel)DataContext).EquipCosmeticCommand}"
                                CommandParameter="{Binding}"
                                FontSize="11" Padding="12,5"
                                IsVisible="{Binding IsOwned}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,*" Margin="0,0,12,12">

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Spacing="3">
                <TextBlock Text="Armario de cosméticos" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding SkinSource}" Classes="caption" FontSize="11"/>
            </StackPanel>
            <Button Content="Cerrar"
                    Classes="ghost"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    FontSize="12" Padding="16,7"/>
        </Grid>

        <!-- Contenido -->
        <Grid Grid.Row="1" ColumnDefinitions="*,320">

            <!-- Visor 3D (no se toca el render GL) -->
            <Border Grid.Column="0"
                    Classes="card"
                    Padding="0"
                    ClipToBounds="True"
                    Margin="0,0,14,0">
                <Grid RowDefinitions="Auto,Auto,*">

                    <Border Grid.Row="0"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding Username}"
                                     Watermark="Buscar por nombre de usuario"
                                     Width="200"
                                     FontSize="12"/>
                            <Button Content="Buscar"
                                    Classes="primary"
                                    Command="{Binding SearchSkinCommand}"
                                    FontSize="12"
                                    Padding="14,6"/>
                            <Button Content="Equipar"
                                    Classes="ghost"
                                    Command="{Binding LoadSkinCommand}"
                                    FontSize="12"
                                    Padding="12,6"/>
                            <Button Content="Guardar en mi biblioteca"
                                    Classes="ghost"
                                    Command="{Binding SaveToLibraryCommand}"
                                    FontSize="12"
                                    Padding="12,6"/>
                            <ProgressBar IsVisible="{Binding IsLoading}"
                                         IsIndeterminate="True"
                                         Width="70"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Mis skins" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="(sin skins guardadas)" Classes="caption" FontSize="10" VerticalAlignment="Center" IsVisible="{Binding !HasSavedSkins}"/>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding SavedSkins}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="{Binding Name}"
                                                        Classes="ghost"
                                                        Command="{Binding $parent[UserControl].((vm:SkinsPreviewViewModel)DataContext).EquipSavedSkinCommand}"
                                                        CommandParameter="{Binding}"
                                                        FontSize="11"
                                                        Padding="10,4"/>
                                                <Button Content="Quitar"
                                                        Classes="ghost"
                                                        Foreground="{StaticResource DangerBrush}"
                                                        Command="{Binding $parent[UserControl].((vm:SkinsPreviewViewModel)DataContext).DeleteSavedSkinCommand}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Quitar skin de Mis Skins"
                                                        FontSize="11"
                                                        Padding="8,4"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource AppBackgroundBrush}" ClipToBounds="True">
                        <Grid>
                            <controls:SkinPreviewGLControl x:Name="SkinPreviewControl"
                                                           HorizontalAlignment="Stretch"
                                                           VerticalAlignment="Stretch"
                                                           MinHeight="160"/>
                            <TextBlock Text="Busca un usuario de Minecraft para cargar y previsualizar la skin en 3D"
                                       IsVisible="{Binding !HasSkin}"
                                       Classes="caption"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Panel de cosméticos -->
            <Border Grid.Column="1" Classes="card" Padding="0" ClipToBounds="True">
                <Grid RowDefinitions="*,Auto">

                    <TabControl Grid.Row="0" Background="Transparent" Padding="6">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="Capas" FontSize="12" Margin="2,0"/>
                            </TabItem.Header>
                            <ScrollViewer>
                                <StackPanel Margin="6">
                                    <TextBlock Text="Tu capa de Mojang se carga automáticamente al cargar la skin."
                                               Classes="caption" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                    <ItemsControl ItemsSource="{Binding Capes}"
                                                  ItemTemplate="{StaticResource CosmeticTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="Sombreros" FontSize="12" Margin="2,0"/>
                            </TabItem.Header>
                            <ScrollViewer>
                                <StackPanel Margin="6">
                                    <ItemsControl ItemsSource="{Binding Hats}"
                                                  ItemTemplate="{StaticResource CosmeticTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="Alas" FontSize="12" Margin="2,0"/>
                            </TabItem.Header>
                            <ScrollViewer>
                                <StackPanel Margin="6">
                                    <ItemsControl ItemsSource="{Binding Wings}"
                                                  ItemTemplate="{StaticResource CosmeticTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Controles del visor -->
                    <Border Grid.Row="1"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,10">
                        <StackPanel Spacing="6">
                            <CheckBox Content="Capa visible"
                                      IsChecked="{Binding IsCapeVisible, Mode=TwoWay}"
                                      IsEnabled="{Binding HasCape}"
                                      FontSize="11"/>
                            <CheckBox Content="Animación al caminar"
                                      IsChecked="{Binding WalkAnimation, Mode=TwoWay}"
                                      FontSize="11"/>
                            <CheckBox Content="Giro automático"
                                      IsChecked="{Binding AutoRotate, Mode=TwoWay}"
                                      FontSize="11"/>
                            <CheckBox Content="Modelo slim (Alex)"
                                      IsChecked="{Binding IsSlim, Mode=TwoWay}"
                                      FontSize="11"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

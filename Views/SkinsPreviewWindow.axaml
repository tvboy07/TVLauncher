<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TVLauncher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:TVLauncher.Controls"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="TVLauncher.Views.SkinsPreviewWindow"
        x:DataType="vm:SkinsPreviewViewModel"
        Title="TVLauncher - Armario de Cosméticos"
        Width="800" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="#121212">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="ARMARIO / TIENDA DE COSMÉTICOS" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="White"/>
            <TextBlock Text="Prueba tus cosméticos en tiempo real" 
                       Foreground="#AAAAAA"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 3D Preview Area -->
            <Border Grid.Column="0" 
                    Background="#1E1E1E" 
                    BorderBrush="#3F3F3F" 
                    BorderThickness="1"
                    CornerRadius="4"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252525" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1" Padding="15,10">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBox Text="{Binding Username}" 
                                     Watermark="Nickname"
                                     Width="200"
                                     Background="#2D2D2D"
                                     Foreground="White"/>
                            <Button Content="Cargar Skin" 
                                    Command="{Binding LoadSkinCommand}"
                                    Background="#0078D4"
                                    Foreground="White"
                                    Padding="15,5"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SkinPreviewBorder" Grid.Row="1" Background="#0F0F0F" MinHeight="200" MinWidth="200">
                        <controls:SkinPreviewGLControl x:Name="SkinPreviewControl" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MinHeight="200" MinWidth="200"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Cosmetics Panel -->
            <Border Grid.Column="1" 
                    Background="#1E1E1E" 
                    BorderBrush="#3F3F3F" 
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252525" BorderBrush="#3F3F3F" BorderThickness="0,0,0,1">
                        <TextBlock Text="COSMÉTICOS DISPONIBLES" 
                                   Foreground="#FFFFFF"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="15,0"/>
                    </Border>

                    <ListBox Grid.Row="1" 
                             ItemsSource="{Binding AvailableCosmetics}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" 
                                                   Foreground="White"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Type}" 
                                                   Foreground="#AAAAAA"
                                                   FontSize="11"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" 
                                            Content="Equipar" 
                                            Command="{Binding $parent[Window].((vm:SkinsPreviewViewModel)DataContext).EquipCosmeticCommand}"
                                            CommandParameter="{Binding}"
                                            Background="#107C10"
                                            Foreground="White"
                                            Padding="10,5"
                                            IsVisible="{Binding IsOwned}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status -->
        <TextBlock Grid.Row="2" 
                   Text="{Binding StatusMessage}" 
                   Foreground="#AAAAAA"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>

# ===== .gitignore de TVLauncher (.NET / C# / Avalonia) =====

# --- Salidas de compilación ---
bin/
obj/
[Bb]in/
[Oo]bj/
publish/
artifacts/
*.nupkg
*.snupkg

# Artefactos históricos que nunca deben versionarse
obj.zip

# --- Estado de usuario/IDE ---
*.user
*.suo
*.cache
*.DotSettings.user
.vs/
.idea/
.vscode/

# --- Pruebas y cobertura ---
TestResults/
*.trx
*.coverage
coverage*.xml

# --- Logs y diagnósticos de ejecución ---
*.log
logs/
crash-reports/
hs_err_pid*.log
replay_pid*.log

# --- Datos de Minecraft descargados o a medio descargar ---
*.part
AppData/
.localhistory/

# --- Temporales de pruebas locales ---
tmp/
temp/
*.tmp
*.temp
build_test.ps1
*.ps1.user
debug*.txt
view.txt
out.txt
tvlauncher_debug.txt
ui*.ps1
uitest*.ps1
shot*.ps1

# --- Sistema operativo / editor ---
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
